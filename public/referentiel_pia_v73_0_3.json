      "FREQUENCE": {
        "libelle": "Fréquence ou répétition explicitement documentée",
        "description": "Quantification ou répétition exprimée dans la source, sans extrapolation.",
        "exemples": [
          "à chaque étape",
          "plusieurs fois",
          "3-4 fois",
          "régulièrement"
        ],
        "source": "EXPLICITE",
        "interdit": "Ne pas inventer une fréquence absente.",
        "marqueurs_recurrence_implicite": [
          "encore",
          "toujours",
          "de nouveau",
          "à nouveau",
          "reste nécessaire",
          "continue à",
          "continue de",
          "faut encore",
          "doit encore",
          "à nouveau"
        ],
        "regle": "Un marqueur lexical de récurrence peut être traité comme FREQUENCE explicite du point de vue linguistique lorsqu'il porte clairement sur le phénomène décrit; ne pas en déduire une fréquence numérique."
      }
    },
