    "regles_initiales": {
      "observation": "Une information isolée reste une OBSERVATION.",
      "signal": "Un phénomène peut devenir SIGNAL soit après au moins deux séances distinctes suffisamment comparables, soit dans une seule séance lorsque la fréquence ou la répétition est explicitement documentée et que le contexte est suffisamment précis. Le signal local reste limité au phénomène et au contexte documentés.",
      "tendance": "Une répétition dans plusieurs séances distinctes et suffisamment comparables peut devenir TENDANCE.",
      "tendance_qualifiee": "Une tendance doit être qualifiée lorsque la condition, le contexte ou une variabilité importante modifie son interprétation.",
      "proposition": "Une PROPOSITION nécessite une convergence suffisante et une formulation PIA explicable; elle reste soumise à validation.",
      "aucune_conclusion": "Si les données sont insuffisantes, contradictoires ou non comparables, le moteur ne doit pas forcer une conclusion PIA.",
      "validation": "Seul le professionnel peut transformer une PROPOSITION en VALIDEE.",
      "proposition_multi_source_intra_session": {
        "autorisee": true,
        "conditions": [
          "au_moins_deux_sources_q_distinctes_pertinentes",
          "phenomene_coherent",
          "besoin_pia_formulable",
          "aucune_relation_interdite",
          "aucune_donnee_manquante_critique_pour_la_formulation",
          "statut_reste_PROPOSITION"
        ],
        "exclusions": [
          "ne_pas_inventer_Q5_ou_Q6_absent",
          "ne_pas_conclure_sur_autonomie_si_non_documentee",
          "ne_pas_conclure_sur_transfert_si_non_documente",
          "ne_pas_produire_VALIDEE"
        ]
      },
      "signal_local_fortement_caracterise": {
        "autorisee": true,
        "description": "Une seule séance peut produire un SIGNAL local lorsqu'une unité est fortement caractérisée par plusieurs relations sémantiques convergentes autour d'un phénomène fonctionnel identifiable, même sans fréquence explicite.",
        "conditions": [
          "phenomene_fonctionnel_identifiable",
          "au_moins_deux_relations_semantiques_coherentes",
          "contexte_suffisamment_precis_ou_condition_explicitement_documentee",
          "absence_de_relation_interdite"
        ],
        "exemples_de_structure": [
          "AIDE + AUTONOMIE + RESSOURCE",
          "DIFFICULTE + CONDITION + RESSOURCE",
          "RESSOURCE + DIFFICULTE + ADAPTATION + CONDITION"
        ],
        "limites": [
          "ne_compte_pas comme plusieurs seances independantes",
          "ne_permet_pas une generalisation transversale non documentee",
          "ne_permet_pas une validation PIA automatique"
        ]
      }
    },
